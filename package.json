{
  "name": "deutschbahn-navigator",
  "version": "1.3.6",
  "description": "Deutsche Bahn Navigator - A Deutsche Bahn information extension for Claude Desktop (no API required)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "demo": "npm run build && node demo.js",
    "pack": "node create-dxt.js",
    "pack:patch": "node create-dxt.js --patch",
    "pack:minor": "node create-dxt.js --minor",
    "pack:major": "node create-dxt.js --major",
    "pack:timestamp": "node create-dxt.js --timestamp",
    "package": "npm run pack",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "mcp",
    "claude-desktop",
    "extension",
    "dxt",
    "deutsche-bahn",
    "db",
    "trains",
    "railway",
    "offline"
  ],
  "author": {
    "name": "Asdrubal Gonzalez Penton",
    "email": "agpenton@gmail.com",
    "url": "https://github.com/agpenton"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agpenton/deutschbahn-navigator"
  },
  "homepage": "https://github.com/agpenton/deutschbahn-navigator",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.3",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.1",
    "jest": "^30.1.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
