{
  "name": "@agpenton/deutschbahn-mcp",
  "version": "0.1.0",
  "description": "MCP server for Deutsche Bahn transport information with station search, departures, arrivals, facilities and journey planning",
  "license": "MIT",
  "type": "module",
  "author": "agpenton (https://github.com/agpenton)",
  "keywords": [
    "deutsche-bahn",
    "db",
    "transport",
    "train",
    "germany",
    "mcp",
    "desktop-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agpenton/deutschebahn"
  },
  "homepage": "https://github.com/agpenton/deutschebahn",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "deutschbahn-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "scripts"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "npm run sync-version && tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "sync-version": "node scripts/sync-version.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src tests --ext .ts,.js,.mjs",
    "lint:fix": "eslint src tests --ext .ts,.js,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "package-dxt": "node scripts/package-dxt.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.11.0",
    "axios-retry": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "nock": "^14.0.10",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
