{
  "name": "deutschbahn-navigator",
  "version": "1.3.3",
  "description": "Deutsche Bahn Navigator - Train search and listing functionality for Claude Desktop",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "demo": "npm run build && node demo.js",
    "pack": "node create-dxt.js",
    "pack:patch": "node create-dxt.js --patch",
    "pack:minor": "node create-dxt.js --minor",
    "pack:major": "node create-dxt.js --major",
    "pack:timestamp": "node create-dxt.js --timestamp",
    "package": "npm run pack",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "deutsche-bahn",
    "train",
    "travel",
    "mcp",
    "claude-desktop",
    "extension",
    "dxt"
  ],
  "author": {
    "name": "Asdrubal Gonzalez Penton",
    "email": "agpenton@gmail.com",
    "url": "https://github.com/agpenton"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agpenton/deutschbahn-navigator"
  },
  "homepage": "https://github.com/agpenton/deutschbahn-navigator",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^3.23.8",
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "node-fetch": "^3.3.2",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/archiver": "^6.0.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
