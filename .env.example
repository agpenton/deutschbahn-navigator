# Environment Configuration Template
# Copy this file to .env and fill in your values

# Deutsche Bahn API Key (REQUIRED)
# Get this from https://developers.deutschebahn.com/
DB_API_KEY=

# API Base URL (optional, uses default if not set)
DB_API_BASE_URL=https://apis.deutschebahn.com

# Development Settings
DB_NAVIGATOR_HTTP=false
DB_NAVIGATOR_HTTP_PORT=3000
DB_NAVIGATOR_LOG_LEVEL=info
DB_NAVIGATOR_TIMEOUT=30000
DB_NAVIGATOR_MAX_RETRIES=3
